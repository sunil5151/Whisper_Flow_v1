-module.exports = { run, repoRoot, hooksDir };
+function lastCommit(cwd) {
+  const raw = run(['log', '-1', '--format=%h%x1f%s'], cwd);
+  const parts = raw.split('\x1f');
+  return {
+    hash: parts[0] || '',
+    subject: parts[1] || ''
+  };
+}
+
+function changedFiles(cwd) {
+  const raw = run(['diff-tree', '--root', '--no-commit-id', '--numstat', '-r', 'HEAD'], cwd);
+  if (!raw) return [];
+  const lines = raw.split('\n').filter(Boolean);
+  return lines.map(line => {
+    const [added, deleted, file] = line.split('\t');
+    return {
+      file,
+      added: added === '-' ? '-' : parseInt(added, 10) || 0,
+      deleted: deleted === '-' ? '-' : parseInt(deleted, 10) || 0
+    };
+  });
+}
+
+module.exports = { run, repoRoot, hooksDir, lastCommit, changedFiles };
diff --git a/src/hook.js b/src/hook.js
index d0e82e1..8663806 100644
--- a/src/hook.js
+++ b/src/hook.js
@@ -1,3 +1,79 @@
-function run() {}
+const fs = require('node:fs');
+const path = require('node:path');
+const { repoRoot, lastCommit, changedFiles } = require('./git');
+const { memoryDir, memoHome } = require('./paths');
+const { redact } = require('./redact');
+
+function pad(n) {
+  return String(n).padStart(2, '0');
+}
+
+function getLocalTimestamp() {
+  const d = new Date();
+  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}`;
+}
+
+function run() {
+  try {
+    let root;
+    try {
+      root = repoRoot(process.cwd());
+    } catch {
+      process.exit(0);
+    }
+
+    const memDir = memoryDir(root);
+    if (!fs.existsSync(memDir)) {
+      process.exit(0);
+    }
+
+    const allFiles = changedFiles(root);
+    const nonMemoryFiles = allFiles.filter(item => !item.file.startsWith('.memory/') && !item.file.startsWith('.memory\\'));
+
+    if (allFiles.length > 0 && nonMemoryFiles.length === 0) {
+      process.exit(0);
+    }
+
+    const commit = lastCommit(root);
+    const { text: redactedSubject } = redact(commit.subject);
+    const timestamp = getLocalTimestamp();
+
+    let filesSummary = '';
+    if (allFiles.length === 0) {
+      filesSummary = 'Files: (merge or empty commit)';
+    } else {
+      const displayed = allFiles.slice(0, 15);
+      const parts = displayed.map(f => {
+        const add = f.added === '-' ? '-' : `+${f.added}`;
+        const del = f.deleted === '-' ? '-' : `-${f.deleted}`;
+        return `${f.file} (${add} ${del})`;
+      });
+      filesSummary = `Files: ${parts.join(', ')}`;
+      if (allFiles.length > 15) {
+        filesSummary += `, +${allFiles.length - 15} more`;
+      }
+    }
+
+    const progressFile = path.join(memDir, 'progress.md');
+    const entry = `\n## ${timestamp} · commit ${commit.hash}\n${redactedSubject}\n${filesSummary}\n`;
+    fs.appendFileSync(progressFile, entry, 'utf8');
+
+    try {
+      const { buildBrief } = require('./brief');
+      const briefContent = buildBrief(root);
+      fs.writeFileSync(path.join(memDir, 'BRIEF.md'), briefContent, 'utf8');
+    } catch {}
+  } catch (err) {
+    try {
+      const home = memoHome();
+      fs.mkdirSync(home, { recursive: true });
+      const logPath = path.join(home, 'hook-errors.log');
+      const msg = `[${new Date().toISOString()}] ${err.stack || err.message}\n`;
+      fs.appendFileSync(logPath, msg, 'utf8');
+    } catch {}
+  } finally {
+    process.exit(0);
+  }
+}
 
 module.exports = { run };
