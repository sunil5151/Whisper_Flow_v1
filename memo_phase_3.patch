new file mode 100644
index 0000000..3333333
--- /dev/null
+++ b/src/note.js
@@ -0,0 +1,96 @@
+const fs = require('node:fs');
+const path = require('node:path');
+const { repoRoot } = require('./git');
+const { memoryDir, memoHome } = require('./paths');
+const { redact } = require('./redact');
+
+function pad(n) {
+  return String(n).padStart(2, '0');
+}
+
+function getLocalTimestamp() {
+  const d = new Date();
+  const yyyy = d.getFullYear();
+  const mm = pad(d.getMonth() + 1);
+  const dd = pad(d.getDate());
+  const hh = pad(d.getHours());
+  const min = pad(d.getMinutes());
+  return `${yyyy}-${mm}-${dd} ${hh}:${min}`;
+}
+
+function run(argv) {
+  let type = null;
+  let isPersonal = false;
+  let textParts = [];
+
+  for (let i = 0; i < argv.length; i++) {
+    const arg = argv[i];
+    if (arg === '-t' || arg === '--type') {
+      type = argv[i + 1];
+      i++;
+    } else if (arg === '--personal') {
+      isPersonal = true;
+    } else {
+      textParts.push(arg);
+    }
+  }
+
+  const rawText = textParts.join(' ').trim();
+
+  if (isPersonal) {
+    if (!rawText) {
+      console.error('Error: missing text for personal note');
+      process.exit(1);
+    }
+    const { text, count } = redact(rawText);
+    const home = memoHome();
+    fs.mkdirSync(home, { recursive: true });
+    const personalPath = path.join(home, 'personal.md');
+    
+    if (!fs.existsSync(personalPath)) {
+      fs.writeFileSync(personalPath, '# About me\n', 'utf8');
+    }
+    fs.appendFileSync(personalPath, `- ${text}\n`, 'utf8');
+    console.log(`Saved → ~/.memo/personal.md`);
+    if (count > 0) {
+      console.log(`⚠ ${count} secret(s) redacted`);
+    }
+    return;
+  }
+
+  const validTypes = ['decision', 'error', 'next'];
+  if (!type || !validTypes.includes(type) || !rawText) {
+    console.error(`Error: usage: memo note -t <decision|error|next> <text...>`);
+    console.error(`Valid types: ${validTypes.join(', ')}`);
+    process.exit(1);
+  }
+
+  let root;
+  try {
+    root = repoRoot(process.cwd());
+  } catch (err) {
+    console.error(`Error: Run "memo init" first`);
+    process.exit(1);
+  }
+
+  const memDir = memoryDir(root);
+  if (!fs.existsSync(memDir)) {
+    console.error(`Error: Run "memo init" first`);
+    process.exit(1);
+  }
+
+  const { text, count } = redact(rawText);
+  const timestamp = getLocalTimestamp();
+
+  if (type === 'decision' || type === 'error') {
+    const filename = `${type}s.md`;
+    const filePath = path.join(memDir, filename);
+    const entry = `\n## ${timestamp} · ${type}\n${text}\n`;
+    fs.appendFileSync(filePath, entry, 'utf8');
+    console.log(`Saved → .memory/${filename}`);
+  } else if (type === 'next') {
+    const filePath = path.join(memDir, 'next.md');
+    const entry = `- [ ] ${text}\n`;
+    fs.appendFileSync(filePath, entry, 'utf8');
+    console.log(`Saved → .memory/next.md`);
+  }
+
+  if (count > 0) {
+    console.log(`⚠ ${count} secret(s) redacted`);
+  }
+}
+
+module.exports = run;
diff --git a/src/redact.js b/src/redact.js
new file mode 100644
index 0000000..4444444
--- /dev/null
+++ b/src/redact.js
@@ -0,0 +1,38 @@
+const PATTERNS = [
+  { regex: /-----BEGIN [A-Z ]*PRIVATE KEY-----[\s\S]*?-----END [A-Z ]*PRIVATE KEY-----/g, keepLabel: false },
+  { regex: /\bsk-[A-Za-z0-9_-]{16,}\b/g, keepLabel: false },
+  { regex: /\b(gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,})\b/g, keepLabel: false },
+  { regex: /\bAKIA[0-9A-Z]{16}\b/g, keepLabel: false },
+  { regex: /\bAIza[0-9A-Za-z_-]{35}\b/g, keepLabel: false },
+  { regex: /\bxox[abprs]-[A-Za-z0-9-]{10,}\b/g, keepLabel: false },
+  { regex: /\beyJ[\w-]+\.[\w-]+\.[\w-]+\b/g, keepLabel: false },
+  { regex: /\bBearer\s+\S+/gi, keepLabel: false },
+  { regex: /\b(password|passwd|pwd|secret|token|api[_-]?key)\s*([:=])\s*(\S+)/gi, keepLabel: true }
+];
+
+function redact(text) {
+  if (typeof text !== 'string') return { text: '', count: 0 };
+  let count = 0;
+  let redacted = text;
+
+  for (const p of PATTERNS) {
+    redacted = redacted.replace(p.regex, (match, p1, p2, p3) => {
+      count++;
+      if (p.keepLabel && p1 && p2) {
+        return `${p1}${p2}[REDACTED]`;
+      }
+      return '[REDACTED]';
+    });
+  }
+
+  return { text: redacted, count };
+}
+
+module.exports = { redact };
diff --git a/test/redact.test.js b/test/redact.test.js
new file mode 100644
index 0000000..5555555
--- /dev/null
+++ b/test/redact.test.js
@@ -0,0 +1,60 @@
+const test = require('node:test');
+const assert = require('node:assert');
+const { redact } = require('../src/redact');
+
+test('redacts OpenAI/Anthropic keys', () => {
+  const res = redact('my key is sk-1234567890abcdef12345678');
+  assert.strictEqual(res.text, 'my key is [REDACTED]');
+  assert.strictEqual(res.count, 1);
+});
+
+test('redacts GitHub tokens', () => {
+  const res = redact('token ghp_1234567890abcdefghijklmnopqrstuvwxyzAB');
+  assert.strictEqual(res.text, 'token [REDACTED]');
+  assert.strictEqual(res.count, 1);
+});
+
+test('redacts AWS access keys', () => {
+  const res = redact('AWS AKIAIOSFODNN7EXAMPLE');
+  assert.strictEqual(res.text, 'AWS [REDACTED]');
+  assert.strictEqual(res.count, 1);
+});
+
+test('redacts Google keys', () => {
+  const res = redact('AIzaSyD-1234567890abcdefghijklmnopqrstuvwxyzAB');
+  assert.strictEqual(res.text, '[REDACTED]');
+  assert.strictEqual(res.count, 1);
+});
+
+test('redacts Slack tokens', () => {
+  const res = redact('xoxb-1234567890-abcdef');
+  assert.strictEqual(res.text, '[REDACTED]');
+  assert.strictEqual(res.count, 1);
+});
+
+test('redacts JWTs', () => {
+  const res = redact('eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjjUxNjIzOTAyMn0.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c');
+  assert.strictEqual(res.text, '[REDACTED]');
+  assert.strictEqual(res.count, 1);
+});
+
+test('redacts Bearer tokens case-insensitively', () => {
+  const res = redact('bearer secrettoken123');
+  assert.strictEqual(res.text, '[REDACTED]');
+  assert.strictEqual(res.count, 1);
+});
+
+test('redacts key=value secrets while keeping label', () => {
+  const res = redact('password=supersecret123 and api_key:mykeyval');
+  assert.strictEqual(res.text, 'password=[REDACTED] and api_key:[REDACTED]');
+  assert.strictEqual(res.count, 2);
+});
+
+test('redacts private key blocks', () => {
+  const pem = '-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA0...\n-----END RSA PRIVATE KEY-----';
+  const res = redact(`Key:\n${pem}\nDone.`);
+  assert.strictEqual(res.text, 'Key:\n[REDACTED]\nDone.');
+  assert.strictEqual(res.count, 1);
+});
+
+test('leaves normal sentences unchanged', () => {
+  const text = 'Hello world! This is a normal sentence with 123 numbers.';
+  const res = redact(text);
+  assert.strictEqual(res.text, text);
+  assert.strictEqual(res.count, 0);
+});