+const fs = require('node:fs');
+const path = require('node:path');
+const { repoRoot } = require('./git');
+const { memoryDir, memoHome } = require('./paths');
+
+function pad(n) {
+  return String(n).padStart(2, '0');
+}
+
+function getLocalTimestamp() {
+  const d = new Date();
+  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}`;
+}
+
+function parseEntries(filePath) {
+  if (!fs.existsSync(filePath)) return [];
+  const content = fs.readFileSync(filePath, 'utf8');
+  const parts = content.split(/(?=^## )/gm);
+  const entries = [];
+  for (const p of parts) {
+    const trimmed = p.trim();
+    if (trimmed) {
+      entries.push(trimmed);
+    }
+  }
+  return entries.reverse(); // Newest first
+}
+
+function buildBrief(root) {
+  const memDir = memoryDir(root);
+  const repoName = path.basename(root);
+  const timestamp = getLocalTimestamp();
+
+  const progressEntries = parseEntries(path.join(memDir, 'progress.md'));
+  const decisionEntries = parseEntries(path.join(memDir, 'decisions.md'));
+  const errorEntries = parseEntries(path.join(memDir, 'errors.md'));
+
+  const nextPath = path.join(memDir, 'next.md');
+  let openNext = [];
+  if (fs.existsSync(nextPath)) {
+    const lines = fs.readFileSync(nextPath, 'utf8').split('\n');
+    openNext = lines.filter(l => l.startsWith('- [ ] '));
+  }
+
+  const home = memoHome();
+  const personalPath = path.join(home, 'personal.md');
+  let aboutMeLines = [];
+  if (fs.existsSync(personalPath)) {
+    const pContent = fs.readFileSync(personalPath, 'utf8');
+    const pLines = pContent.split('\n').filter(l => l.trim() !== '');
+    // Skip title if present
+    const filtered = pLines.filter(l => !l.startsWith('# '));
+    aboutMeLines = filtered.slice(0, 20);
+  }
+
+  const recentDecisions = decisionEntries.slice(0, 10);
+  const recentErrors = errorEntries.slice(0, 5);
+  const recentCommits = progressEntries.slice(0, 10);
+
+  function assemble(cCommits, cDecisions, cErrors, cNext) {
+    let lines = [];
+    lines.push(`# BRIEF — ${repoName}`);
+    lines.push(`Generated ${timestamp} by memo. Do not edit; run \`memo brief\`.`);
+    lines.push('');
+
+    if (aboutMeLines.length > 0) {
+      lines.push('## About me');
+      lines.push(...aboutMeLines);
+      lines.push('');
+    }
+
+    lines.push('## Open next steps');
+    if (cNext.length > 0) {
+      lines.push(...cNext);
+    } else {
+      lines.push('(none yet)');
+    }
+    lines.push('');
+
+    lines.push('## Recent decisions (last 10)');
+    lines.push(cDecisions.length > 0 ? cDecisions.join('\n\n') : '(none yet)');
+    lines.push('');
+
+    lines.push('## Recent errors (last 5)');
+    lines.push(cErrors.length > 0 ? cErrors.join('\n\n') : '(none yet)');
+    lines.push('');
+
+    lines.push('## Recent commits (last 10)');
+    lines.push(cCommits.length > 0 ? cCommits.join('\n\n') : '(none yet)');
+
+    return lines.join('\n');
+  }
+
+  let briefText = assemble(recentCommits, recentDecisions, recentErrors, openNext);
+  let briefLines = briefText.split('\n');
+
+  // Hard cap enforcement: 150 lines limit, trimming oldest commits -> decisions -> errors -> next steps if needed
+  while (briefLines.length > 150) {
+    if (recentCommits.length > 0) { recentCommits.pop(); }
+    else if (recentDecisions.length > 0) { recentDecisions.pop(); }
+    else if (recentErrors.length > 0) { recentErrors.pop(); }
+    else if (openNext.length > 0) {
+      openNext.pop();
+      if (openNext.length === 0) { openNext.push('…truncated in next.md'); break; }
+    } else { break; }
+    briefText = assemble(recentCommits, recentDecisions, recentErrors, openNext);
+    briefLines = briefText.split('\n');
+  }

+  return briefText;
+}
+
+function run() {
+  const root = repoRoot(process.cwd());
+  const content = buildBrief(root);
+  const memDir = memoryDir(root);
+  const briefPath = path.join(memDir, 'BRIEF.md');
+  fs.writeFileSync(briefPath, content, 'utf8');
+  const lineCount = content.split('\n').length;
+  console.log(`BRIEF.md written (${lineCount} lines)`);
+}
+
+module.exports = { buildBrief, run };